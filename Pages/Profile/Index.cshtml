@page
@model SearchPlant.Pages.Profile.IndexModel
@{
    ViewData["Title"] = "Hồ sơ người dùng";
    Layout = User.IsInRole("Admin") ? "/Pages/Shared/_AdminLayout.cshtml" : "/Pages/Shared/_Layout.cshtml";
}

<div class="profile-page">
    <div class="container my-5">
        <!-- Header -->
        <div class="profile-header">
            <h1 class="profile-title"><i class="bi bi-person-circle me-2"></i>Quản lý tài khoản</h1>
            <p class="lead text-muted">Cập nhật thông tin cá nhân và bảo mật của bạn.</p>
        </div>

        <!-- Thông báo trạng thái -->
        @if (!string.IsNullOrEmpty(Model.StatusMessage))
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @Model.StatusMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- Tabs cho các section -->
        <ul class="nav nav-tabs nav-tabs-bordered mb-4" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="info-tab" data-bs-toggle="tab" data-bs-target="#info" type="button"
                    role="tab" aria-controls="info" aria-selected="true"><i
                        class="bi bi-info-circle-fill me-2"></i>Thông tin cá nhân</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="security-tab" data-bs-toggle="tab" data-bs-target="#security" type="button"
                    role="tab" aria-controls="security" aria-selected="false"><i
                        class="bi bi-shield-lock-fill me-2"></i>Bảo mật</button>
            </li>

        </ul>

        <div class="tab-content">
            <!-- Section Thông tin cá nhân -->
            <div class="tab-pane fade show active" id="info" role="tabpanel" aria-labelledby="info-tab">
                <div class="row g-4">
                    <div class="col-md-6 mx-auto">
                        <div class="profile-card">
                            <div class="card-body text-center">
                                <img id="avatarPreview"
                                    src="@(string.IsNullOrEmpty(Model.AvatarUrl) ? "/images/default-avatar.png" : Model.AvatarUrl)"
                                    alt="User Avatar" class="profile-avatar mb-3" />
                                <form id="avatar-form" asp-page-handler="UpdateAvatar" method="post"
                                    enctype="multipart/form-data">
                                    @Html.AntiForgeryToken()
                                    <div class="mb-3">
                                        <label class="form-label">Tải lên avatar mới</label>
                                        <input type="file" class="form-control" name="AvatarFile" accept="image/*"
                                            id="avatarUpload" />
                                    </div>
                                    <button type="submit" class="btn btn-success w-100"><i
                                            class="bi bi-upload me-2"></i>Cập nhật avatar</button>
                                </form>
                            </div>
                        </div>

                        <div class="profile-card mt-4">
                            <div class="card-body">
                                <form id="profile-form" method="post" asp-page-handler="UpdateProfile">
                                    @Html.AntiForgeryToken()
                                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                                    <div class="mb-3">
                                        <label asp-for="ProfileInput.Username" class="form-label">Tên người dùng</label>
                                        <input asp-for="ProfileInput.Username" class="form-control" />
                                        <span asp-validation-for="ProfileInput.Username" class="text-danger"></span>
                                    </div>
                                    <div class="mb-3">
                                        <label asp-for="Email" class="form-label">Email</label>
                                        <input asp-for="Email" class="form-control" disabled />
                                    </div>
                                    <div class="mb-3">
                                        <label asp-for="ProfileInput.AvatarUrl" class="form-label">URL ảnh đại diện (tùy
                                            chọn)</label>
                                        <input asp-for="ProfileInput.AvatarUrl" class="form-control" id="avatarUrlInput"
                                            placeholder="https://example.com/avatar.jpg" />
                                        <span asp-validation-for="ProfileInput.AvatarUrl" class="text-danger"></span>
                                    </div>
                                    <button type="submit" class="btn btn-success w-100"><i
                                            class="bi bi-floppy me-2"></i>Lưu thay đổi</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Section Bảo mật -->
            <div class="tab-pane fade" id="security" role="tabpanel" aria-labelledby="security-tab">
                <div class="row g-4">
                    <div class="col-md-6 mx-auto">
                        <div class="profile-card">
                            <div class="card-body">
                                <h5 class="mb-3">Đổi mật khẩu</h5>
                                <form id="password-form" method="post" asp-page-handler="ChangePassword">
                                    @Html.AntiForgeryToken()
                                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                                    @if (!Model.HasPassword)
                                    {
                                        <div class="alert alert-info">Bạn chưa có mật khẩu. Bạn có thể tạo mật khẩu mới ở đây.</div>
                                    }
                                    else
                                    {
                                        <div class="mb-3">
                                            <label asp-for="ChangePasswordInput.CurrentPassword" class="form-label">Mật khẩu hiện tại</label>
                                            <input asp-for="ChangePasswordInput.CurrentPassword" class="form-control" type="password" />
                                            <span asp-validation-for="ChangePasswordInput.CurrentPassword" class="text-danger"></span>
                                        </div>
                                    }
                                    <div class="mb-3">
                                        <label asp-for="ChangePasswordInput.NewPassword" class="form-label">Mật khẩu mới</label>
                                        <input asp-for="ChangePasswordInput.NewPassword" class="form-control" type="password" />
                                        <span asp-validation-for="ChangePasswordInput.NewPassword" class="text-danger"></span>
                                    </div>
                                    <div class="mb-3">
                                        <label asp-for="ChangePasswordInput.ConfirmPassword" class="form-label">Xác nhận mật khẩu mới</label>
                                        <input asp-for="ChangePasswordInput.ConfirmPassword" class="form-control" type="password" />
                                        <span asp-validation-for="ChangePasswordInput.ConfirmPassword" class="text-danger"></span>
                                    </div>
                                    <button type="submit" class="btn btn-success w-100">Cập nhật mật khẩu</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Nút quay lại -->
        <div class="mt-5 text-center">
            <a href="@(User.IsInRole("Admin") ? "/Admin/Dashboard/Index" : "/")" class="btn btn-outline-success">
                <i class="bi bi-arrow-left me-2"></i>Quay lại
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Khởi tạo Bootstrap Tooltips
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) { return new bootstrap.Tooltip(tooltipTriggerEl); });

            // Preview avatar khi upload file
            const avatarUpload = document.getElementById('avatarUpload');
            const avatarPreview = document.getElementById('avatarPreview');
            const avatarUrlInput = document.getElementById('avatarUrlInput');
            const defaultAvatar = '/images/default-avatar.png';

            avatarUpload.addEventListener('change', function (e) {
                const file = e.target.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = function (e) {
                        avatarPreview.src = e.target.result;
                    };
                    reader.readAsDataURL(file);
                }
            });

            // Preview avatar khi nhập URL
            avatarUrlInput.addEventListener('input', function () {
                const url = this.value.trim();
                avatarPreview.onerror = function () {
                    avatarPreview.src = defaultAvatar;
                    avatarPreview.onerror = null;
                };
                if (url && (url.startsWith('http://') || url.startsWith('https://'))) {
                    avatarPreview.src = url;
                } else {
                    avatarPreview.src = defaultAvatar;
                }
            });
        });
    </script>
}