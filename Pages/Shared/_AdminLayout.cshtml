<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Admin Dashboard</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    <link rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/@@eonasdan/tempus-dominus@6.9.4/dist/css/tempus-dominus.min.css"
        crossorigin="anonymous">


    @await RenderSectionAsync("Styles", required: false)
</head>

<body style="font-family: 'Inter', sans-serif;">
    <div class="admin-th">
        <div class="d-flex" style="min-height: 100vh;">
            <!-- Sidebar -->
            <aside class="admin-sidebar">
                <h4><i class="bi bi-shield-check me-2"></i>Admin Panel</h4>
                <ul class="nav flex-column">
                    <li class="nav-item"><a href="/Admin" class="nav-link"><i class="bi bi-speedometer2 me-2"></i>Tổng
                            quan</a></li>
                    <li class="nav-item"><a href="/PlantsManager" class="nav-link"><i
                                class="fas fa-leaf me-2"></i>Quản lý cây</a></li>
                    <!-- NEW SECTION 1: Quản lý thuộc tính -->
                    <li class="nav-item">
                        <a href="/PropertiesManager" class="nav-link">
                            <i class="fas fa-sliders-h"></i>
                            <span>Quản lý thuộc tính</span>
                        </a>
                    </li>

                    <!-- NEW SECTION 2: Dịch bệnh và Trị liệu -->
                    <li class="nav-item">
                        <a href="/#" class="nav-link" data-bs-toggle="collapse" data-bs-target="#diseaseTreatmentMenu" aria-expanded="false">
                            <i class="fas fa-shield-virus"></i>
                            <span>Dịch bệnh & Trị liệu</span>
                            <i class="bi bi-chevron-down ms-auto"></i>
                        </a>
                        <ul class="collapse list-unstyled ms-3" id="diseaseTreatmentMenu">
                            <li><a href="/DiseasesManager" class="nav-link">Quản lý bệnh</a></li>
                            <li><a href="/TreatmentsManager" class="nav-link">Quản lý trị liệu</a></li>
                        </ul>
                    </li>
                    <li class="nav-item"><a href="/UserManager" class="nav-link"><i class="bi bi-people me-2"></i>Người
                            dùng</a></li>
                    <li class="nav-item"><a href="/#" class="nav-link"><i class="bi bi-gear me-2"></i>Cài đặt</a>
                    </li>
                    <form method="post" asp-page="/Logout/Index">
                        <button type="submit" class="nav-link text-danger border-0 bg-transparent">
                            <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                        </button>
                    </form>
                </ul>
            </aside>

            <!-- Main content -->
            <main class="flex-grow-1 bg-light">
                <!-- Header navbar mới -->
                <nav class="admin-navbar-new d-flex justify-content-between align-items-center px-4">
                    <!-- Logo -->
                    <div class="d-flex align-items-center gap-3">
                        <a href="/Admin" class="navbar-brand d-flex align-items-center gap-2">
                            <i class="fas fa-leaf fs-3 text-success"></i>
                            <span class="fw-bold fs-5 text-success">SearchPlant</span>
                        </a>
                    </div>
                    <!-- Search box nổi bật -->
                    <form method="get" asp-page="/PlantsManager/Index"
                        class="search-box-new d-flex align-items-center mx-3">
                        <input type="text" name="SearchString" value="@Context.Request.Query["SearchString"]"
                            class="form-control rounded-pill" placeholder="Tìm cây..." />
                        <button type="submit" class="btn btn-search-new ms-2">
                            <i class="bi bi-search"></i>
                        </button>
                    </form>
                    <!-- Profile + thông báo -->
                    <div class="d-flex align-items-center gap-3">
                        <a href="/#" class="btn btn-icon position-relative">
                            <i class="bi bi-bell fs-5"></i>
                            <span
                                class="badge bg-danger position-absolute top-0 start-100 translate-middle p-1 rounded-circle"></span>
                        </a>
                        <div class="admin-profile-new d-flex align-items-center gap-2">
                            <span class="fw-semibold d-none d-md-inline">@User.Identity.Name</span>
                            <div class="dropdown">
                                <button class="btn p-0 border-0 bg-transparent dropdown-toggle"
                                    data-bs-toggle="dropdown" aria-expanded="false" style="outline: none;">
                                    <img src="@(User.FindFirst("AvatarUrl")?.Value ?? "/images/avatar.png")"
                                        class="rounded-circle admin-avatar" width="38" height="38" alt="Avatar" />
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" href="/Profile"><i class="bi bi-person me-2"></i> Hồ
                                            sơ</a></li>
                                    <li>
                                        <hr class="dropdown-divider">
                                    </li>
                                    <li>
                                        <form method="post" asp-page="/Logout/Index">
                                            <button class="dropdown-item text-danger"><i
                                                    class="bi bi-box-arrow-right me-2"></i> Đăng xuất</button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </nav>
                <div class="container-fluid p-4">
                    @RenderBody()
                </div>
            </main>
        </div>
    </div>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script>
        // JS ở phần dưới
    </script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <!-- Popperjs (cần cho Tempus Dominus) -->
    <script src="https://cdn.jsdelivr.net/npm/@@popperjs/core@2.11.6/dist/umd/popper.min.js"
        crossorigin="anonymous"></script>
    <!-- Tempus Dominus v6 JS -->
    <script src="https://cdn.jsdelivr.net/npm/@@eonasdan/tempus-dominus@6.9.4/dist/js/tempus-dominus.min.js"
        crossorigin="anonymous"></script>

    @await RenderSectionAsync("Scripts", required: false)



</body>

</html>