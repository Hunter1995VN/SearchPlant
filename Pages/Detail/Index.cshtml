                // HÀM NÀY VỪA CẬP NHẬT NÚT, VỪA "BẮN" SỰ KIỆN LÊN HEADER
                function updateFavoriteButton(buttonElement, newIsFavoritedState) {
                    // --- Phần 1: Cập nhật giao diện của chính cái nút vừa click ---
                    var btnText = buttonElement.find('#favorite-btn-text');
                    var btnIcon = buttonElement.find('i');
                    
                    buttonElement.data('is-favorited', newIsFavoritedState);

                    if (newIsFavoritedState) {
                        buttonElement.removeClass('btn-outline-success').addClass('btn-success');
                        btnIcon.removeClass('bi-heart').addClass('bi-heart-fill');
                        btnText.text('Đã yêu thích');
                    } else {
                        buttonElement.removeClass('btn-success').addClass('btn-outline-success');
                        btnIcon.removeClass('bi-heart-fill').addClass('bi-heart');
                        btnText.text('Thêm vào yêu thích');
                    }

                    // --- Phần 2: Gửi thông báo lên cho bộ đếm ở header ---
                    const counterBadge = document.getElementById('favorites-counter-badge');
                    if (counterBadge) { // Chỉ thực hiện nếu tìm thấy bộ đếm
                        let currentCount = parseInt(counterBadge.textContent) || 0;
                        const newCount = newIsFavoritedState ? currentCount + 1 : Math.max(0, currentCount - 1);

                        // Tạo và bắn ra sự kiện tùy chỉnh
                        const updateEvent = new CustomEvent('favoritesUpdated', { 
                            detail: { 
                                count: newCount 
                            } 
                        });
                        document.dispatchEvent(updateEvent);
                    }
                }
            });
        </script>
        
