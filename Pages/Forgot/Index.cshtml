@page
@model SearchPlant.Pages.Forgot.IndexModel
@{
    Layout = null;
    ViewData["Title"] = "Recovery pasword";
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Recover Password</title>
    <link rel="stylesheet" href="~/css/login.css">
</head>

<body>
    <div class="nature-background">
        <div class="floating-leaf leaf-1"></div>
        <div class="floating-leaf leaf-2"></div>
        <div class="floating-leaf leaf-3"></div>
        <div class="floating-leaf leaf-4"></div>
    </div>

    <div class="login-container">
        <div class="wellness-card">
            <div class="organic-border"></div>

            <div class="mindful-header">
                <div class="zen-logo">
                    <!-- SVG logo giống login -->
                </div>
                <h1>Forgot Password</h1>
                <p>We’ll help you find your way back</p>
            </div>

            <form method="post" class="harmony-form" novalidate>
                <div class="organic-field">
                    <div class="field-nature"></div>
                    <input type="email" id="email" name="Email" value="@Model.Email" required autocomplete="email"
                        placeholder=" ">
                    <label for="email">Enter your email</label>
                    <span class="gentle-error" id="emailError"></span>
                </div>

                <button type="submit" class="harmony-button">
                    <div class="button-earth"></div>
                    <span class="button-text">Send Recovery Link</span>
                    <div class="button-growth">
                        <div class="growing-circle circle-1"></div>
                        <div class="growing-circle circle-2"></div>
                        <div class="growing-circle circle-3"></div>
                    </div>
                    <div class="button-aura"></div>
                </button>
            </form>

            @if (!string.IsNullOrEmpty(Model.Message))
            {
                <div class="alert-warning">
                    @Model.Message
                </div>
            }

            <div class="nurture-signup">
                <span>Remembered it? </span>
                <a asp-page="/Login/Index" class="growth-link">Return to login</a>
            </div>
        </div>
    </div>

    <script src="~/js/login.js"></script>
</body>

</html>