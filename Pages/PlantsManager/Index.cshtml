@page
@model SearchPlant.Pages.PlantsManager.IndexModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý cây trồng";
}

<div class="plant-manager-page">
    <div class="main-content-card">
        <!-- TIÊU ĐỀ VÀ NÚT THÊM MỚI -->
        <div class="manager-header">
            <div class="title-group">
                <!-- THAY ĐỔI Ở ĐÂY: Thêm class "text-success" vào thẻ h4 -->
                <h4 class="text-success"><i class="fas fa-leaf me-2"></i>Quản lý cây trồng</h4>
                <p>Toàn bộ danh sách cây trong hệ thống của bạn.</p>
            </div>
            <div class="actions-group">
                <a asp-page="/AddPlant/Index" class="btn btn-success"><i class="bi bi-plus-lg me-2"></i>Add new
                    plant</a>
            </div>
        </div>

        <!-- THANH LỌC VÀ SẮP XẾP HOÀN CHỈNH -->
        <div class="filter-bar mb-4">
            <form method="get" id="filter-form">
                <input type="hidden" name="SearchString" value="@Model.SearchString" />
                <div class="row g-3">
                    <div class="col-md-4 col-lg-2">
                        <label class="form-label fw-500 text-muted small">Loại cây</label>
                        <select class="form-select auto-submit-filter" asp-for="FilterTypeId"
                            asp-items="Model.PlantTypes"></select>
                    </div>
                    <div class="col-md-4 col-lg-2">
                        <label class="form-label fw-500 text-muted small">Vùng trồng</label>
                        <select class="form-select auto-submit-filter" asp-for="FilterRegionId"
                            asp-items="Model.Regions"></select>
                    </div>
                    <div class="col-md-4 col-lg-2">
                        <label class="form-label fw-500 text-muted small">Chu kỳ</label>
                        <select class="form-select auto-submit-filter" asp-for="FilterCycleId"
                            asp-items="Model.Cycles"></select>
                    </div>
                    <div class="col-md-4 col-lg-2">
                        <label class="form-label fw-500 text-muted small">Mùa vụ</label>
                        <select class="form-select auto-submit-filter" asp-for="FilterSeasonId"
                            asp-items="Model.Seasons"></select>
                    </div>
                    <div class="col-md-4 col-lg-2">
                        <label class="form-label fw-500 text-muted small">Loại đất</label>
                        <select class="form-select auto-submit-filter" asp-for="FilterSoilId"
                            asp-items="Model.SoilTypes"></select>
                    </div>
                    <div class="col-md-4 col-lg-2">
                        <label class="form-label fw-500 text-muted small">Phân bón</label>
                        <select class="form-select auto-submit-filter" asp-for="FilterFertilizerId"
                            asp-items="Model.Fertilizers"></select>
                    </div>
                    <div class="col-md-4 col-lg-2">
                        <label class="form-label fw-500 text-muted small">Bệnh</label>
                        <select class="form-select auto-submit-filter" asp-for="FilterDiseaseId"
                            asp-items="Model.Diseases"></select>
                    </div>
                    <div class="col-md-4 col-lg-2">
                        <label class="form-label fw-500 text-muted small">Đặc tính</label>
                        <select class="form-select auto-submit-filter" asp-for="FilterPropertyId"
                            asp-items="Model.Properties"></select>
                    </div>
                    <div class="col-md-4 col-lg-2">
                        <label class="form-label fw-500 text-muted small">Tưới nước</label>
                        <select class="form-select auto-submit-filter" asp-for="FilterWateringId"
                            asp-items="Model.WateringMethods"></select>
                    </div>
                    <div class="col-md-4 col-lg-2">
                        <label class="form-label fw-500 text-muted small">Bảo tồn</label>
                        <select class="form-select auto-submit-filter" asp-for="FilterStatusId"
                            asp-items="Model.ConservationStatuses"></select>
                    </div>
                    <div class="col-md-4 col-lg-2">
                        <label class="form-label fw-500 text-muted small">Sắp xếp</label>
                        <select class="form-select auto-submit-filter" asp-for="SortOrder">
                            <option value="date_desc">Mới nhất</option>
                            <option value="date_asc">Cũ nhất</option>
                            <option value="name_asc">Tên A-Z</option>
                            <option value="name_desc">Tên Z-A</option>
                            <option value="id_asc">ID Tăng dần</option>
                            <option value="id_desc">ID Giảm dần</option>
                        </select>
                    </div>
                </div>
            </form>
        </div>

        <!-- KHU VỰC THÔNG BÁO -->
        @if (!string.IsNullOrEmpty(Model.SearchString))
        {
            <div class="alert alert-info">Hiển thị kết quả cho: <strong>"@Model.SearchString"</strong>. <a
                    asp-page="/PlantsManager/Index" class="alert-link">Xóa bộ lọc</a>.</div>
        }
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">@TempData["SuccessMessage"]</div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
        }

        <!-- BẢNG DỮ LIỆU NÂNG CẤP -->
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th style="width: 5%;">ID</th>
                        <th style="width: 8%;">Ảnh</th>
                        <th style="width: 25%;">Tên cây</th>
                        <th style="width: 15%;">Chu kỳ</th>
                        <th style="width: 22%;">Vùng trồng</th>
                        <th style="width: 10%;">Ngày cập nhật</th>
                        <th style="width: 15%;" class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var backUrl = Url.Page("/PlantsManager/Index", new
                        {
                            Model.SearchString,
                            Model.CurrentPage,
                            Model.SortOrder
                        });
                    }
                    @foreach (var plant in Model.Plants)
                    {
                        <tr>
                            <td class="plant-id">@plant.Plantid</td>
                            <td>
                                <a asp-page="/Detail/Index" asp-route-id="@plant.Plantid" asp-route-returnUrl="@backUrl">
                                    <img src="@(string.IsNullOrEmpty(plant.Imagepath) ? "/images/placeholder.png" : plant.Imagepath)"
                                        alt="@plant.Plantname" class="plant-thumbnail" data-bs-toggle="tooltip"
                                        data-bs-placement="top" title="@plant.Tooltiptext" />
                                </a>
                            </td>
                            <td>
                                <a asp-page="/Detail/Index" asp-route-id="@plant.Plantid" asp-route-returnUrl="@backUrl"
                                    class="text-decoration-none text-dark">
                                    <div class="plant-name" data-bs-toggle="tooltip" data-bs-placement="top"
                                        title="@plant.Tooltiptext">@plant.Plantname</div>
                                    <div class="scientific-name">@plant.Scientificname</div>
                                </a>
                            </td>
                            <td>@plant.Cycle?.Cyclename</td>
                            <td>@string.Join(", ", plant.Regions.Select(r => r.Regionname))</td>
                            <td class="update-date">@plant.Lastupdated?.ToString("dd/MM/yyyy")</td>

                            <td class="text-end action-buttons">
                                <a asp-page="/Editplant/Index" asp-route-id="@plant.Plantid" asp-route-returnUrl="@backUrl"
                                    class="btn btn-action" title="Chỉnh sửa">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <form method="post" asp-page-handler="Delete" asp-route-id="@plant.Plantid"
                                    class="d-inline delete-form">
                                    <input type="hidden" name="SearchString" value="@Model.SearchString" />
                                    <input type="hidden" name="CurrentPage" value="@Model.CurrentPage" />
                                    <input type="hidden" name="SortOrder" value="@Model.SortOrder" />
                                    <button type="submit" class="btn btn-action text-danger" title="Xóa">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (!Model.Plants.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">Không tìm thấy cây nào phù hợp.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- PHÂN TRANG NÂNG CẤP -->
        @if (Model.TotalPages > 1)
        {
            <div class="pagination-footer">
                <div class="text-muted small">Hiển thị <strong>@Model.Plants.Count</strong> trên tổng số
                    <strong>@Model.TotalPlants</strong> cây
                </div>
                <nav>
                    <ul class="pagination mb-0">
                        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link" asp-page="./Index" asp-route-CurrentPage="@(Model.CurrentPage - 1)"
                                asp-route-SearchString="@Model.SearchString"
                                asp-route-SortOrder="@Model.SortOrder">&laquo;</a>
                        </li>
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-page="./Index" asp-route-CurrentPage="@i"
                                    asp-route-SearchString="@Model.SearchString" asp-route-SortOrder="@Model.SortOrder">@i</a>
                            </li>
                        }
                        <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" asp-page="./Index" asp-route-CurrentPage="@(Model.CurrentPage + 1)"
                                asp-route-SearchString="@Model.SearchString"
                                asp-route-SortOrder="@Model.SortOrder">&raquo;</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        // Lắng nghe sự kiện 'DOMContentLoaded' để đảm bảo tất cả các phần tử đã được tải
        document.addEventListener('DOMContentLoaded', function () {

            // Tìm form bộ lọc
            const filterForm = document.getElementById('filter-form');

            // Nếu tìm thấy form
            if (filterForm) {
                // Lấy tất cả các thẻ select có class 'auto-submit-filter'
                const autoSubmitElements = filterForm.querySelectorAll('.auto-submit-filter');

                // Gắn sự kiện 'change' cho mỗi thẻ select
                autoSubmitElements.forEach(function (element) {
                    element.addEventListener('change', function () {
                        // Khi người dùng thay đổi lựa chọn, tự động submit form
                        filterForm.submit();
                    });
                });
            }

            // Đoạn script cho SweetAlert2 (nếu bạn có)
            // Ví dụ: xử lý form xóa
            const deleteForms = document.querySelectorAll('.delete-form');
            deleteForms.forEach(form => {
                form.addEventListener('submit', function (event) {
                    event.preventDefault(); // Ngăn form submit ngay lập tức
                    Swal.fire({
                        title: 'Bạn có chắc chắn không?',
                        text: "Bạn sẽ không thể hoàn tác hành động này!",
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#3085d6',
                        cancelButtonColor: '#d33',
                        confirmButtonText: 'Vâng, xóa nó!',
                        cancelButtonText: 'Hủy'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            form.submit(); // Nếu người dùng xác nhận, submit form
                        }
                    })
                });
            });
        });
    </script>
}