@page
@model SearchPlant.Pages.About.IndexModel
@{
	ViewData["Title"] = "About Us - SearchPlant";
}

<!-- Hero Section -->
<section class="hero-section py-5">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h1 class="display-4 fw-bold mb-4 text-success">Về SearchPlant</h1>
                <p class="lead mb-4 text-dark">
                    Nền tảng thông minh cung cấp giải pháp toàn diện cho việc tìm kiếm, chẩn đoán và chăm sóc cây trồng.
                </p>
                <div class="d-flex gap-3">
                    <a href="/Diagnosis" class="btn btn-success btn-lg">
                        <i class="bi bi-search me-2"></i>Bắt đầu chẩn đoán
                    </a>
                    <a href="#mission" class="btn btn-outline-success btn-lg">
                        Tìm hiểu thêm
                    </a>
                </div>
            </div>
            <div class="col-lg-6 text-center">
                <i class="bi bi-flower1 hero-icon text-success"></i>
            </div>
        </div>
    </div>
</section>

<!-- Mission Section -->
<section id="mission" class="py-5 bg-light">
    <div class="container">
        <div class="row">
            <div class="col-lg-8 mx-auto text-center">
                <h2 class="mb-4 text-success">Sứ mệnh của chúng tôi</h2>
                <p class="lead mb-4">
                    SearchPlant được tạo ra với mục tiêu giúp nông dân, người yêu cây trồng và các chuyên gia nông nghiệp
                    có thể chăm sóc cây trồng một cách thông minh hơn, cải thiện năng suất và bảo vệ môi trường.
                </p>
                <div class="row g-4 mt-4">
                    <div class="col-md-4">
                        <div class="feature-card h-100">
                            <i class="bi bi-eye text-success fs-1 mb-3"></i>
                            <h5>Nhận diện chính xác</h5>
                            <p>Định danh loài cây và phát hiện bệnh kịp thời</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="feature-card h-100">
                            <i class="bi bi-lightbulb text-success fs-1 mb-3"></i>
                            <h5>Hướng dẫn chuyên nghiệp</h5>
                            <p>Cung cấp giải pháp chăm sóc phù hợp</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="feature-card h-100">
                            <i class="bi bi-shield-check text-success fs-1 mb-3"></i>
                            <h5>Bảo vệ môi trường</h5>
                            <p>Giảm thiểu sử dụng hóa chất, thân thiện với môi trường</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Team Section -->
<section class="py-5">
    <div class="container">
        <div class="row">
            <div class="col-12 text-center mb-5">
                <h2 class="text-success">Đội ngũ phát triển</h2>
                <p class="lead">Đội ngũ đam mê công nghệ và nông nghiệp</p>
            </div>
        </div>
        <div class="row g-4">
            <div class="col-md-6 col-lg-3">
                <div class="team-card text-center">
                    <div class="team-avatar mb-3">
                        <i class="bi bi-person-circle fs-1 text-success"></i>
                    </div>
                    <h5>Product Owner</h5>
                    <p class="text-muted">Định hướng sản phẩm và chiến lược</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="team-card text-center">
                    <div class="team-avatar mb-3">
                        <i class="bi bi-code-slash fs-1 text-success"></i>
                    </div>
                    <h5>Developers</h5>
                    <p class="text-muted">Phát triển tính năng và API</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="team-card text-center">
                    <div class="team-avatar mb-3">
                        <i class="bi bi-robot fs-1 text-success"></i>
                    </div>
                    <h5>AI/ML Engineers</h5>
                    <p class="text-muted">Mô hình nhận diện và chẩn đoán</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="team-card text-center">
                    <div class="team-avatar mb-3">
                        <i class="bi bi-palette fs-1 text-success"></i>
                    </div>
                    <h5>UI/UX Designers</h5>
                    <p class="text-muted">Thiết kế trải nghiệm người dùng</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Contact Section -->
<section class="py-5 contact-section">
    <div class="container">
        <div class="row">
            <div class="col-lg-8 mx-auto text-center">
                <h2 class="mb-4 text-success">Liên hệ với chúng tôi</h2>
                <p class="lead mb-4 text-dark">
                    Có câu hỏi hoặc muốn hợp tác? Chúng tôi luôn sẵn sàng lắng nghe và hỗ trợ bạn.
                </p>
                <div class="row g-3 justify-content-center">
                    <div class="col-auto">
                        <a href="mailto:contact@searchplant.example" class="btn btn-outline-success">
                            <i class="bi bi-envelope me-2"></i>Email
                        </a>
                    </div>
                    <div class="col-auto">
                        <a href="#" class="btn btn-outline-success">
                            <i class="bi bi-facebook me-2"></i>Facebook
                        </a>
                    </div>
                    <div class="col-auto">
                        <a href="#" class="btn btn-outline-success">
                            <i class="bi bi-twitter me-2"></i>Twitter
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
