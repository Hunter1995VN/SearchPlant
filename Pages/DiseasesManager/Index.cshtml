@page
@model SearchPlant.Pages.DiseasesManager.IndexModel
@{
    ViewData["Title"] = "Quản lý bệnh cây trồng";
    Layout = "_AdminLayout";
}

<!-- Hero Section -->
<div class="hero-section bg-gradient-danger text-white py-5 mb-4">
    <div class="container-fluid">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <h1 class="display-5 fw-bold mb-3">
                    <i class="fas fa-shield-virus me-3"></i>Quản lý bệnh cây trồng
                </h1>
                <p class="lead mb-0 opacity-75">
                    Quản lý và tổ chức thông tin về các bệnh thường gặp ở cây trồng
                </p>
            </div>
            <div class="col-lg-4 text-end">
                <button type="button" class="btn btn-light btn-lg shadow-lg" data-bs-toggle="modal" data-bs-target="#createModal">
                    <i class="bi bi-plus-circle-fill me-2"></i>Thêm bệnh mới
                </button>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid">
    <!-- Stats Cards -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card stats-card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="stats-icon bg-danger bg-opacity-10 text-danger rounded-circle mx-auto mb-3">
                        <i class="fas fa-shield-virus fs-1"></i>
                    </div>
                    <h3 class="fw-bold text-danger mb-1">@Model.TotalDiseases</h3>
                    <p class="text-muted mb-0">Tổng bệnh</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card stats-card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="stats-icon bg-warning bg-opacity-10 text-warning rounded-circle mx-auto mb-3">
                        <i class="fas fa-seedling fs-1"></i>
                    </div>
                    <h3 class="fw-bold text-warning mb-1">@Model.Diseases.Sum(d => d.Plants.Count)</h3>
                    <p class="text-muted mb-0">Cây bị ảnh hưởng</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card stats-card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="stats-icon bg-info bg-opacity-10 text-info rounded-circle mx-auto mb-3">
                        <i class="fas fa-medkit fs-1"></i>
                    </div>
                    <h3 class="fw-bold text-info mb-1">@Model.Diseases.Sum(d => d.Treatments.Count)</h3>
                    <p class="text-muted mb-0">Phương pháp trị</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Success/Error Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Search Bar -->
    <div class="data-card card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            <form method="get" class="d-flex gap-3 align-items-center">
                <div class="flex-grow-1">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0">
                            <i class="bi bi-search text-muted"></i>
                        </span>
                              <input type="text" name="SearchString" value="@Model.SearchString"
                                  class="form-control form-control-lg border-start-0 ps-0"
                               placeholder="Tìm kiếm theo tên bệnh, triệu chứng hoặc nguyên nhân..." />
                    </div>
                </div>
                <button type="submit" class="btn btn-success btn-lg px-4">
                    <i class="bi bi-search me-2"></i>Tìm kiếm
                </button>
                <a href="?SearchString=" class="btn btn-outline-secondary btn-lg px-4">
                    <i class="bi bi-x-circle me-2"></i>Xóa lọc
                </a>
            </form>
        </div>
    </div>

    <!-- Diseases List -->
    <div class="card data-card border-0 shadow-sm">
        <div class="card-header bg-white border-bottom-0 py-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="mb-1 fw-bold text-dark">
                        <i class="fas fa-shield-virus me-2 text-danger"></i>Danh sách bệnh
                    </h5>
                    <p class="text-muted mb-0 small">@Model.TotalDiseases bệnh trong hệ thống</p>
                </div>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-outline-primary" onclick="refreshPage()">
                        <i class="bi bi-arrow-clockwise me-2"></i>Làm mới
                    </button>
                </div>
            </div>
        </div>
        <div class="card-body p-0">
            @if (Model.Diseases.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="border-0 fw-semibold text-muted ps-4">
                                    <i class="bi bi-hash me-2"></i>ID
                                </th>
                                <th class="border-0 fw-semibold text-muted">
                                    <i class="fas fa-shield-virus me-2"></i>Tên bệnh
                                </th>
                                <th class="border-0 fw-semibold text-muted">
                                    <i class="bi bi-exclamation-triangle me-2"></i>Triệu chứng
                                </th>
                                <th class="border-0 fw-semibold text-muted">
                                    <i class="bi bi-search me-2"></i>Nguyên nhân
                                </th>
                                <th class="border-0 fw-semibold text-muted text-center">
                                    <i class="fas fa-seedling me-2"></i>Cây bị
                                </th>
                                <th class="border-0 fw-semibold text-muted text-center">
                                    <i class="fas fa-medkit me-2"></i>Phương pháp trị
                                </th>
                                <th class="border-0 fw-semibold text-muted text-center">
                                    <i class="bi bi-gear me-2"></i>Thao tác
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var disease in Model.Diseases)
                            {
                                <tr class="align-middle">
                                    <td class="ps-4 fw-monospace text-muted">#@disease.Diseaseid</td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="disease-icon bg-danger bg-opacity-10 text-danger rounded-circle me-3 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                                <i class="fas fa-shield-virus"></i>
                                            </div>
                                            <div>
                                                <h6 class="mb-0 fw-semibold">@disease.Diseasename</h6>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="text-muted small">
                                            @(disease.Symptoms ?? "Chưa có thông tin")
                                        </span>
                                    </td>
                                    <td>
                                        <span class="text-muted small">
                                            @(disease.Cause ?? "Chưa xác định")
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-warning bg-opacity-10 text-warning px-3 py-2 rounded-pill">
                                            <i class="fas fa-seedling me-1"></i>@disease.Plants.Count cây
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-info bg-opacity-10 text-info px-3 py-2 rounded-pill">
                                            <i class="fas fa-medkit me-1"></i>@disease.Treatments.Count phương pháp
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <button type="button" class="btn btn-sm btn-outline-primary rounded-start"
                                                    data-bs-toggle="modal" data-bs-target="#editModal"
                                                    onclick="editDisease(@disease.Diseaseid, '@disease.Diseasename', '@(disease.Symptoms?.Replace("'", "\\'") ?? "")', '@(disease.Cause?.Replace("'", "\\'") ?? "")')"
                                                    title="Chỉnh sửa">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-danger rounded-end"
                                                    onclick="deleteDisease(@disease.Diseaseid, '@disease.Diseasename')"
                                                    title="Xóa">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                @if (Model.TotalPages > 1)
                {
                    <nav aria-label="Page navigation" class="mt-4 mb-3">
                        <ul class="pagination pagination-modern justify-content-center">
                            @if (Model.CurrentPage > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="?page=@(Model.CurrentPage - 1)&searchString=@Model.SearchString" aria-label="Previous">
                                        <i class="bi bi-chevron-left"></i>
                                    </a>
                                </li>
                            }

                            @for (int i = Math.Max(1, Model.CurrentPage - 2); i <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); i++)
                            {
                                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link" href="?page=@i&searchString=@Model.SearchString">@i</a>
                                </li>
                            }

                            @if (Model.CurrentPage < Model.TotalPages)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="?page=@(Model.CurrentPage + 1)&searchString=@Model.SearchString" aria-label="Next">
                                        <i class="bi bi-chevron-right"></i>
                                    </a>
                                </li>
                            }
                        </ul>
                    </nav>
                }
            }
            else
            {
                <div class="text-center py-5">
                    <div class="empty-state-icon bg-light rounded-circle mx-auto mb-4 d-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                        <i class="fas fa-shield-virus fs-1 text-muted"></i>
                    </div>
                    <h5 class="text-muted mb-3">Không tìm thấy bệnh nào</h5>
                    <p class="text-muted mb-4">Hãy thêm bệnh mới để bắt đầu quản lý.</p>
                    <button type="button" class="btn btn-primary btn-lg" data-bs-toggle="modal" data-bs-target="#createModal">
                        <i class="bi bi-plus-circle me-2"></i>Thêm bệnh đầu tiên
                    </button>
                </div>
            }
        </div>
    </div>
</div>

<!-- Create Modal -->
<div class="modal fade" id="createModal" tabindex="-1" aria-labelledby="createModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg">
            <form method="post" asp-page-handler="Create">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title fw-bold" id="createModalLabel">
                        <i class="fas fa-shield-virus me-2"></i>Thêm bệnh mới
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-4">
                        <label for="Disease_Diseasename" class="form-label fw-semibold">
                            <i class="fas fa-shield-virus me-2 text-danger"></i>Tên bệnh <span class="text-danger">*</span>
                        </label>
                        <input type="text" class="form-control form-control-lg" id="Disease_Diseasename"
                               name="Disease.Diseasename" required
                               placeholder="Nhập tên bệnh..." />
                        <div class="form-text">Tên bệnh phải là duy nhất trong hệ thống</div>
                    </div>
                    <div class="mb-4">
                        <label for="Disease_Symptoms" class="form-label fw-semibold">
                            <i class="bi bi-exclamation-triangle me-2 text-warning"></i>Triệu chứng
                        </label>
                        <textarea class="form-control" id="Disease_Symptoms" name="Disease.Symptoms"
                                  rows="4" placeholder="Mô tả các triệu chứng của bệnh..."></textarea>
                    </div>
                    <div class="mb-3">
                        <label for="Disease_Cause" class="form-label fw-semibold">
                            <i class="bi bi-search me-2 text-info"></i>Nguyên nhân
                        </label>
                        <textarea class="form-control" id="Disease_Cause" name="Disease.Cause"
                                  rows="4" placeholder="Mô tả nguyên nhân gây bệnh..."></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">
                        <i class="bi bi-x-circle me-2"></i>Hủy
                    </button>
                    <button type="submit" class="btn btn-danger px-4">
                        <i class="bi bi-check-circle me-2"></i>Thêm bệnh
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editModal" tabindex="-1" aria-labelledby="editModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg">
            <form method="post" asp-page-handler="Edit">
                <input type="hidden" id="editId" name="id" />
                <div class="modal-header bg-warning text-dark">
                    <h5 class="modal-title fw-bold" id="editModalLabel">
                        <i class="bi bi-pencil-square me-2"></i>Chỉnh sửa bệnh
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-4">
                        <label for="editDiseasename" class="form-label fw-semibold">
                            <i class="fas fa-shield-virus me-2 text-danger"></i>Tên bệnh <span class="text-danger">*</span>
                        </label>
                        <input type="text" class="form-control form-control-lg" id="editDiseasename"
                               name="Disease.Diseasename" required
                               placeholder="Nhập tên bệnh..." />
                        <div class="form-text">Tên bệnh phải là duy nhất trong hệ thống</div>
                    </div>
                    <div class="mb-4">
                        <label for="editSymptoms" class="form-label fw-semibold">
                            <i class="bi bi-exclamation-triangle me-2 text-warning"></i>Triệu chứng
                        </label>
                        <textarea class="form-control" id="editSymptoms" name="Disease.Symptoms"
                                  rows="4" placeholder="Mô tả các triệu chứng của bệnh..."></textarea>
                    </div>
                    <div class="mb-3">
                        <label for="editCause" class="form-label fw-semibold">
                            <i class="bi bi-search me-2 text-info"></i>Nguyên nhân
                        </label>
                        <textarea class="form-control" id="editCause" name="Disease.Cause"
                                  rows="4" placeholder="Mô tả nguyên nhân gây bệnh..."></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">
                        <i class="bi bi-x-circle me-2"></i>Hủy
                    </button>
                    <button type="submit" class="btn btn-warning px-4">
                        <i class="bi bi-check-circle me-2"></i>Cập nhật
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title fw-bold" id="deleteModalLabel">
                    <i class="bi bi-exclamation-triangle me-2"></i>Xác nhận xóa
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="text-center mb-4">
                    <div class="delete-icon bg-danger bg-opacity-10 text-danger rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                        <i class="fas fa-shield-virus fs-1"></i>
                    </div>
                    <h5 class="fw-bold">Bạn có chắc muốn xóa?</h5>
                    <p class="text-muted mb-0" id="deleteMessage"></p>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-2"></i>Hủy
                </button>
                <button type="button" class="btn btn-danger px-4" id="confirmDeleteBtn">
                    <i class="bi bi-trash me-2"></i>Xóa
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    function editDisease(id, name, symptoms, cause) {
        document.getElementById('editId').value = id;
        document.getElementById('editDiseasename').value = name;
        document.getElementById('editSymptoms').value = symptoms;
        document.getElementById('editCause').value = cause;
    }

    function deleteDisease(id, name) {
        document.getElementById('deleteMessage').innerHTML =
            `Bạn có chắc muốn xóa bệnh <strong>"${name}"</strong>? Hành động này không thể hoàn tác.`;
        document.getElementById('confirmDeleteBtn').onclick = function() {
            const form = document.createElement('form');
            form.method = 'post';
            form.innerHTML = `
                <input type="hidden" name="__RequestVerificationToken" value="@(HttpContext.Request.Cookies["__RequestVerificationToken"] ?? "")" />
                <input type="hidden" name="handler" value="Delete" />
                <input type="hidden" name="id" value="${id}" />
            `;
            document.body.appendChild(form);
            form.submit();
        };
        new bootstrap.Modal(document.getElementById('deleteModal')).show();
    }

    function refreshPage() {
        window.location.reload();
    }

    // Auto-hide alerts after 5 seconds
    document.addEventListener('DOMContentLoaded', function() {
        setTimeout(function() {
            const alerts = document.querySelectorAll('.alert');
            alerts.forEach(alert => {
                const bsAlert = new bootstrap.Alert(alert);
                bsAlert.close();
            });
        }, 5000);
    });
</script>