@page
@model SearchPlant.Pages.ResetPassword.IndexModel
@{
    Layout = null;
    ViewData["Title"] = "Reset Password";
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/login.css">
</head>

<body>
    <div class="nature-background">
        <div class="floating-leaf leaf-1"></div>
        <div class="floating-leaf leaf-2"></div>
        <div class="floating-leaf leaf-3"></div>
        <div class="floating-leaf leaf-4"></div>
    </div>

    <div class="login-container">
        <div class="wellness-card">
            <div class="organic-border"></div>

            <div class="mindful-header">
                <h1 style="color:#2E7D32;">Reset Your Password</h1>
                <p style="font-size:1.1em;color:#555;">Nhập mã OTP vừa nhận qua email và tạo mật khẩu mới cho tài khoản của bạn.</p>
            </div>

            <form method="post" class="harmony-form" novalidate style="margin-top:20px;">
                @if (!string.IsNullOrEmpty(Model.StatusMessage))
                {
                    <div class="alert-message">
                        @Model.StatusMessage
                    </div>
                }

                <div asp-validation-summary="ModelOnly" class="alert-warning"></div>

                <input asp-for="Input.Email" type="hidden" />

                <div class="organic-field">
                    <input asp-for="Input.OtpCode" required autocomplete="one-time-code" placeholder=" ">
                    <label asp-for="Input.OtpCode">Mã OTP</label>
                    <span asp-validation-for="Input.OtpCode" class="gentle-error"></span>
                </div>



                <div class="organic-field">
                    <input type="password" id="resetPassword" name="Input.Password" required placeholder=" ">
                    <label for="resetPassword">Mật khẩu mới</label>
                    <button type="button" class="nature-toggle" id="resetPasswordToggle" aria-label="Toggle password visibility">
                        <svg class="eye-visible" width="20" height="20" viewBox="0 0 20 20" fill="none">
                            <path d="M10 4c-4 0-7 3-8 6 1 3 4 6 8 6s7-3 8-6c-1-3-4-6-8-6zm0 10a4 4 0 110-8 4 4 0 010 8zm0-6a2 2 0 100 4 2 2 0 000-4z" fill="currentColor"/>
                        </svg>
                        <svg class="eye-hidden" width="20" height="20" viewBox="0 0 20 20" fill="none">
                            <path d="M3 3l14 14M8.5 8.5a2 2 0 002.83 2.83m-.83-4.83a4 4 0 014 4M10 6C6 6 3 9 2 12c.5 1.5 2 3.5 4 4.5M10 14c4 0 7-3 8-6-.5-1.5-2-3.5-4-4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </button>
                    <span class="gentle-error" id="resetPasswordError"></span>
                </div>



                <div class="organic-field">
                    <input type="password" id="resetConfirmPassword" name="Input.ConfirmPassword" required placeholder=" ">
                    <label for="resetConfirmPassword">Xác nhận mật khẩu mới</label>
                    <button type="button" class="nature-toggle" id="resetConfirmPasswordToggle" aria-label="Toggle confirm password visibility">
                        <svg class="eye-visible" width="20" height="20" viewBox="0 0 20 20" fill="none">
                            <path d="M10 4c-4 0-7 3-8 6 1 3 4 6 8 6s7-3 8-6c-1-3-4-6-8-6zm0 10a4 4 0 110-8 4 4 0 010 8zm0-6a2 2 0 100 4 2 2 0 000-4z" fill="currentColor"/>
                        </svg>
                        <svg class="eye-hidden" width="20" height="20" viewBox="0 0 20 20" fill="none">
                            <path d="M3 3l14 14M8.5 8.5a2 2 0 002.83 2.83m-.83-4.83a4 4 0 014 4M10 6C6 6 3 9 2 12c.5 1.5 2 3.5 4 4.5M10 14c4 0 7-3 8-6-.5-1.5-2-3.5-4-4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </button>
                    <span class="gentle-error" id="resetConfirmPasswordError"></span>
                </div>

                <button type="submit" class="harmony-button">
                    <div class="button-earth"></div>
                    <span class="button-text">Đổi mật khẩu</span>
                    <div class="button-growth">
                        <div class="growing-circle circle-1"></div>
                        <div class="growing-circle circle-2"></div>
                        <div class="growing-circle circle-3"></div>
                    </div>
                    <div class="button-aura"></div>
                </button>
                <button type="submit" asp-page-handler="ResendOtp" class="harmony-button" id="resendBtn" style="margin-top:10px;background:#4CAF50;">
                    <span class="button-text" id="resendText">Gửi lại mã OTP</span>
                </button>
            </form>

            <div class="nurture-signup">
                <span>Remembered it? </span>
                <a asp-page="/Login/Index" class="growth-link">Return to login</a>
            </div>
        </div>
    </div>

    <script>
    let resendCountdown = @Model.WaitSeconds;
    const resendBtn = document.getElementById('resendBtn');
    const resendText = document.getElementById('resendText');

    function startResendCountdown() {
        if (resendCountdown > 0) {
            resendBtn.disabled = true;
            resendBtn.style.opacity = '0.6';
            resendBtn.style.cursor = 'not-allowed';
            const interval = setInterval(() => {
                if (resendCountdown > 0) {
                    resendText.textContent = `Gửi lại mã (${resendCountdown}s)`;
                    resendCountdown--;
                } else {
                    resendText.textContent = 'Gửi lại mã OTP';
                    resendBtn.disabled = false;
                    resendBtn.style.opacity = '1';
                    resendBtn.style.cursor = 'pointer';
                    clearInterval(interval);
                }
            }, 1000);
        } else {
            resendBtn.disabled = false;
            resendBtn.style.opacity = '1';
            resendBtn.style.cursor = 'pointer';
            resendText.textContent = 'Gửi lại mã OTP';
        }
    }
    window.addEventListener('DOMContentLoaded', () => {
        startResendCountdown();
    });
    </script>
    <script src="~/js/login.js"></script>
</body>
</html>